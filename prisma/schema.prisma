// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// --- ENUMS ---

enum UserRole {
  ADMIN
  DISPATCHER
}

enum RiderStatus {
  ACTIVE
  INACTIVE
  BUSY
}

enum CustomerType {
  BUSINESS
  INDIVIDUAL
}

enum VehicleStatus {
  IN_SERVICE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum OrderStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  EN_ROUTE_TO_PICKUP
  AT_PICKUP
  PICKED_UP
  IN_TRANSIT
  AT_DROPOFF
  DELIVERED
  CANCELLED
  FAILED
}

// SELF : le client se fait livrer à lui-même (aller chercher un produit et
// le lui ramener) — pas de tiers avec l'app en main au point de collecte.
// THIRD_PARTY : livraison classique A→B, expéditeur et destinataire
// distincts, tous les deux avec l'app en main.
enum DeliveryType {
  SELF
  THIRD_PARTY
}

// Choix fait par le client à la commande, uniquement pertinent quand
// deliveryType = SELF (voir logique dans /api/admin/orders/[id]/status).
// AUTO   : on laisse la main à l'app — le blocage GPS à 100m suffit, pas de
//          confirmation tierce attendue à la collecte.
// MANUAL : le client garde le contrôle — même mécanisme de confirmation
//          que pour un expéditeur classique (lien de suivi, rôle SENDER).
enum PickupControlMode {
  AUTO
  MANUAL
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  ONLINE
  ONLINE_MTN
  ONLINE_AIRTEL
  CASH_AT_PICKUP
  CASH_AT_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OtpType {
  PICKUP
  DROPOFF
}

enum AlertType {
  STALL
  DEVIATION
  OFFLINE
  PAYMENT
}

enum TrackingRole {
  SENDER
  RECIPIENT
}

enum ConfirmationStep {
  PICKUP
  DROPOFF
  CASH_PAYMENT
}

enum ConfirmationActor {
  SENDER
  RECIPIENT
  RIDER
}

enum ConfirmationAction {
  CONFIRMED
  DENIED
}

enum PaymentTransactionStatus {
  PENDING
  CONFIRMED
  FAILED
  DISPUTED
}

enum DisputeType {
  PICKUP_MISMATCH
  DROPOFF_MISMATCH
  PAYMENT_MISMATCH
  POST_DELIVERY_CLAIM
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

enum PartnerStatus {
  ACTIVE
  SUSPENDED
}

enum ChatSenderType {
  ADMIN
  RIDER
}

// --- MODELS ---

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(DISPATCHER)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model Rider {
  id             String      @id @default(cuid())
  name           String
  phone          String      @unique
  passwordHash   String?
  vehiclePlate   String
  status         RiderStatus @default(INACTIVE)
  currentLat     Float?
  currentLng     Float?
  currentAddress String?
  rating         Float       @default(5.0)
  joinedAt       DateTime    @default(now())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Colonne géospatiale PostGIS, synchronisée automatiquement depuis
  // currentLat/currentLng par un trigger Postgres (voir prisma/postgis.sql).
  // Non gérée par le client Prisma (type non supporté nativement) : ne sert
  // qu'aux requêtes spatiales brutes dans src/lib/spatial.ts (recherche du
  // livreur le plus proche, index GiST pour tenir à l'échelle de 10 000+
  // motos). Le reste de l'app continue de lire/écrire currentLat/currentLng
  // normalement via Prisma, sans aucun changement.
  location Unsupported("geography(Point, 4326)")?

  // Relations
  vehicles       Vehicle[]
  orders         Order[]
  gpsPings       GpsPing[]
  alerts         Alert[]
  messages       ChatMessage[]
  claims         OrderClaim[]

  @@index([status])
  @@index([createdAt])
}

model Customer {
  id          String       @id @default(cuid())
  name        String
  phone       String
  type        CustomerType @default(INDIVIDUAL)
  address     String
  billingMode String?
  createdAt   DateTime     @default(now())

  // Relations
  orders      Order[]

  @@index([createdAt])
}

model Partner {
  id           String        @id @default(cuid())
  companyName  String
  contactName  String
  email        String        @unique
  passwordHash String
  phone        String
  status       PartnerStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())

  // Relations
  orders       Order[]

  @@index([createdAt])
}

model Vehicle {
  id              String        @id @default(cuid())
  plate           String        @unique
  model           String
  status          VehicleStatus @default(IN_SERVICE)
  mileage         Float         @default(0)
  nextServiceDate DateTime?
  createdAt       DateTime      @default(now())

  // Relations
  rider           Rider?        @relation(fields: [riderId], references: [id])
  riderId         String?

  @@index([createdAt])
}

model Order {
  id                 String               @id @default(cuid())
  trackingNumber     String               @unique // Généré via code "EXP-" + ...
  
  // Client (Optionnel pour cas Guest)
  customer           Customer?            @relation(fields: [customerId], references: [id])
  customerId         String?
  guestCustomerName  String?
  guestCustomerPhone String?

  // Partenaire (Si la commande vient d'un partenaire connecté)
  partner            Partner?             @relation(fields: [partnerId], references: [id])
  partnerId          String?

  // Adresses
  pickupAddress      String
  pickupLat          Float
  pickupLng          Float
  dropoffAddress     String
  dropoffLat         Float
  dropoffLng         Float

  // Nouvelles informations (Public Order)
  pickupZone         String?
  dropoffZone        String?
  pickupLandmark     String?
  dropoffLandmark    String?
  pickupLandmarkRef   Landmark?           @relation("PickupLandmark", fields: [pickupLandmarkId], references: [id])
  pickupLandmarkId    String?
  dropoffLandmarkRef  Landmark?           @relation("DropoffLandmark", fields: [dropoffLandmarkId], references: [id])
  dropoffLandmarkId   String?
  routeGeoJson       Json?
  packageWeight      String?
  declaredValue      Float?

  // Zones de tarification
  zoneFrom           String?
  zoneTo             String?
  quotedManually     Boolean              @default(false)

  // Destinataire
  recipientName      String
  recipientPhone     String

  // Type de livraison — voir enums DeliveryType/PickupControlMode plus haut.
  // pickupControlMode n'a de sens que pour deliveryType = SELF ; laissé
  // null pour les commandes THIRD_PARTY.
  deliveryType       DeliveryType         @default(THIRD_PARTY)
  pickupControlMode  PickupControlMode?

  // Détails colis
  packageDescription String
  amount             Float
  paymentMethod      PaymentMethod        @default(CASH_AT_PICKUP)
  paymentStatus      PaymentStatus        @default(PENDING)
  cashPaymentSubtype String?              // "SENDER_PAYS" | "RECIPIENT_PAYS"
  status             OrderStatus          @default(PENDING)

  // Tokens de suivi public (Legacy/Direct)
  senderToken        String?              @unique
  providerToken      String?              @unique
  recipientToken     String?              @unique

  // Livreur
  rider              Rider?               @relation(fields: [riderId], references: [id])
  riderId            String?

  // Demandes de prise en charge par les chauffeurs (avant validation admin)
  claims             OrderClaim[]

  // Commande enregistrée par un chauffeur après une course prise en direct,
  // hors plateforme (client rencontré sur la route) — comptabilisée dans les
  // recettes comme n'importe quelle autre commande livrée/payée, mais
  // signalée pour la transparence côté admin.
  loggedManually     Boolean              @default(false)

  // Raisons d'échec/annulation
  cancelReason       String?
  failureReason      String?
  riderRating        Int?
  riderReview        String?

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  // Relations
  statusHistory      OrderStatusHistory[]
  otpCodes           OtpCode[]
  gpsPings           GpsPing[]
  alerts             Alert[]
  trackingLinks      TrackingLink[]
  confirmations      Confirmation[]
  transactions       PaymentTransaction[]
  disputes           Dispute[]

  @@index([status])
  @@index([riderId])
  @@index([customerId])
  @@index([partnerId])
  @@index([createdAt])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  status    OrderStatus
  note      String?
  lat       Float?
  lng       Float?
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model OtpCode {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  type       OtpType
  code       String   // 6 chiffres
  verified   Boolean  @default(false)
  attempts   Int      @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([orderId])
}

model OrderClaim {
  id        String      @id @default(cuid())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  rider     Rider       @relation(fields: [riderId], references: [id], onDelete: Cascade)
  riderId   String
  status    ClaimStatus @default(PENDING)
  createdAt DateTime    @default(now())

  // Un chauffeur ne peut demander la même commande qu'une seule fois
  // (évite le spam de clics ; il verra "Demande envoyée" ensuite).
  @@unique([orderId, riderId])
  @@index([orderId])
  @@index([riderId])
}

model GpsPing {
  id        String   @id @default(cuid())
  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  riderId   String
  order     Order?   @relation(fields: [orderId], references: [id])
  orderId   String?
  lat       Float
  lng       Float
  speed     Float?
  heading   Float?
  createdAt DateTime @default(now())

  @@index([riderId])
  @@index([orderId])
  @@index([createdAt])
}

model Alert {
  id          String    @id @default(cuid())
  type        AlertType
  title       String
  description String
  rider       Rider?     @relation(fields: [riderId], references: [id])
  riderId     String?
  order       Order?     @relation(fields: [orderId], references: [id])
  orderId     String?
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([riderId])
  @@index([orderId])
  @@index([resolved])
  @@index([createdAt])
}

model TrackingLink {
  id        String       @id @default(cuid())
  token     String       @unique @default(uuid())
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  role      TrackingRole
  phone     String
  expiresAt DateTime
  createdAt DateTime     @default(now())

  @@index([token])
  @@index([orderId])
}

model Confirmation {
  id        String             @id @default(cuid())
  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  step      ConfirmationStep
  actor     ConfirmationActor
  action    ConfirmationAction
  lat       Float?
  lng       Float?
  createdAt DateTime           @default(now())

  @@index([orderId])
}

model PaymentTransaction {
  id                           String                   @id @default(cuid())
  order                        Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId                      String
  method                       PaymentMethod
  amount                       Float
  status                       PaymentTransactionStatus @default(PENDING)
  externalReference            String?
  confirmedBySenderOrRecipient Boolean                  @default(false)
  confirmedByRider             Boolean                  @default(false)
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  @@index([orderId])
}

model Dispute {
  id               String      @id @default(cuid())
  order            Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String
  type             DisputeType
  description      String
  status           DisputeStatus @default(OPEN)
  resolution       String?
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime    @default(now())

  @@index([orderId])
}

model PricingZone {
  id       String @id @default(cuid())
  zoneName String @unique

  // Contour réel du quartier/zone, prêt pour le jour où les zones seront
  // dessinées sur une carte au lieu du rattachement manuel par repère.
  // Synchronisé à la main (pas de trigger : rempli seulement quand un
  // polygone est dessiné/importé). Voir src/lib/spatial.ts::findZoneForPoint.
  boundary Unsupported("geography(Polygon, 4326)")?

  landmarks Landmark[]
}

model Landmark {
  id            String       @id @default(cuid())
  name          String
  aliases       String[]     @default([])
  lat           Float
  lng           Float
  pricingZone   PricingZone? @relation(fields: [pricingZoneId], references: [id])
  pricingZoneId String?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())

  // Colonne géospatiale PostGIS, synchronisée automatiquement depuis lat/lng
  // par un trigger Postgres (voir prisma/postgis.sql) — même pattern que
  // Rider.location. Sert uniquement à src/lib/spatial.ts::findNearbyLandmarks
  // (suggestion de repères proches d'une position GPS, anti-doublon à
  // l'ajout). Le reste de l'app continue de lire/écrire lat/lng normalement.
  location Unsupported("geography(Point, 4326)")?

  pickupOrders  Order[] @relation("PickupLandmark")
  dropoffOrders Order[] @relation("DropoffLandmark")

  @@index([name])
}

model MotekiProduct {
  id          String   @id @default(cuid())
  amount      Int      @unique
  productUuid String
  label       String?
  createdAt   DateTime @default(now())
}

model ChatMessage {
  id             String            @id @default(cuid())
  rider          Rider             @relation(fields: [riderId], references: [id], onDelete: Cascade)
  riderId        String
  senderType     ChatSenderType
  senderUserId   String?
  content        String
  read           Boolean           @default(false)
  createdAt      DateTime          @default(now())

  @@index([riderId])
  @@index([createdAt])
}

model PricingRule {
  id          String @id @default(cuid())
  zoneFromId  String
  zoneToId    String
  fixedAmount Float? // null = sur devis
}
